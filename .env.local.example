# Collective Media — Talent Marketplace
# Copy this file to `.env.local` and fill in real values.
# These are read ONLY on the server (lib/data/airtable.ts). They never reach the client.

# Airtable Personal Access Token, scoped to data.records:read + data.records:write on this base only.
AIRTABLE_API_KEY=

# The Airtable base ID (starts with "app...").
AIRTABLE_BASE_ID=

# --- Optional table-name overrides (defaults match Section 4 of the build prompt) ---
# AIRTABLE_TABLE_CREATORS=Creators
# AIRTABLE_TABLE_CHANNELS=Channels
# AIRTABLE_TABLE_BOUNDARIES=Brand Boundaries
# AIRTABLE_TABLE_OVERLAP=Overlap Assumptions
# AIRTABLE_TABLE_BUNDLES=Saved Bundles

# --- Sales handoff (public by nature — these appear in links on the page) ---
# Where "Request pricing" sends the buyer. Defaults to partnerships@collective.media.
NEXT_PUBLIC_SALES_EMAIL=
# Optional meeting-booker link (Calendly, HubSpot, Savvycal…). If unset, the
# "Book a call" button is simply not shown.
NEXT_PUBLIC_MEETING_URL=

# --- Site-wide password gate (for a private/preview deployment) ---
# If set, the ENTIRE site (buyer, sales, apply) requires this shared password.
# Leave blank for open local dev. Set it in Vercel to lock the public URL.
SITE_PASSWORD=

# --- Access gating (lightweight MVP role switch) ---
# Optional shared passwords for the internal routes. If unset, routes are open in dev.
SALES_ACCESS_PASSWORD=
ADMIN_ACCESS_PASSWORD=

# When AIRTABLE_API_KEY is empty, the app automatically falls back to the
# local seed dataset in /data so it runs without credentials. Set this to
# "local" to force the local dataset even when Airtable creds are present.
DATA_SOURCE=
